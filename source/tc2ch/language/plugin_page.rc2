IDD_PAGE_PLUGINS DIALOGEX 0, 0, 222, 230
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "MS UI Gothic", 0, 0, 0x1
BEGIN
    CONTROL "",IDC_PL_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,6,6,210,126
    CONTROL "Enable plugin",IDC_PL_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,140,148,11
    PUSHBUTTON "Settings",IDC_PL_SETTINGS,164,138,52,14
    CONTROL "Use as Chime settings page",IDC_PL_PAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,156,210,11
    LTEXT "Description",IDC_PL_LABEL_DESCRIPTION,6,176,210,8
    EDITTEXT IDC_PL_DESCRIPTION,6,188,210,36,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
END

