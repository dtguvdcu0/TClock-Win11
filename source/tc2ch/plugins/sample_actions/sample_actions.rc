/*
 * プラグイン一覧に表示する名前と説明文、DLLの検出に使う情報を定義します。
 * 日本語を扱えるよう、このファイルはUTF-8で保存します。
 */
#pragma code_page(65001)
#include <windows.h>
#include "../../common/plugin_resources.h"

/* 設定画面の説明欄に表示する文章です。英語と日本語を用意します。 */
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    TC_PLUGIN_DESCRIPTION_ID "Adds a builtin operation that copies the current local date and time in ISO format."
END

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
    TC_PLUGIN_DESCRIPTION_ID "現在の日時をISO形式でコピーするビルトイン操作を追加します。"
END

/* 検出用のIDと一覧の名前は、表示言語によらず共通にします。 */
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
STRINGTABLE
BEGIN
    /* コロンの後のIDを、C側の sample_info と揃えます。 */
    TC_PLUGIN_HEADER_ID "tclock.plugin/1:sample.actions"

    /* プラグイン一覧に表示する名前です。 */
    TC_PLUGIN_NAME_ID "SampleActions"

    /*
     * 個別設定がないことを本体に伝え、設定ボタンを無効にします。
     * 設定画面を実装したときは、この指定を外します。
     */
    TC_PLUGIN_SETTINGS_HINT_ID "none"
END

#define SAMPLE_VERSION 1,0,0,0
#define SAMPLE_VERSION_TEXT "1.0.0.0\0"

1 VERSIONINFO
 FILEVERSION SAMPLE_VERSION
 PRODUCTVERSION SAMPLE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "SampleActions plugin\0"
            VALUE "FileVersion", SAMPLE_VERSION_TEXT
            VALUE "InternalName", "SampleActions\0"
            VALUE "OriginalFilename", "SampleActions.dll\0"
            VALUE "ProductName", "SampleActions\0"
            VALUE "ProductVersion", SAMPLE_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
