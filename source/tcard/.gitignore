# Generated build output (keep build/ scripts and project files).
bin/
obj/
out/
x64/
x86/
Debug/
Release/
*.exe
*.dll
*.lib
*.exp
*.obj
*.pdb
*.ilk
*.ipdb
*.iobj
*.tlog
*.lastbuildstate
*.msix
*.appx

# IDE and language-tool caches.
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb
ipch/
__pycache__/
