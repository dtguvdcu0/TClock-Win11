tcard/
cards/
cards.json
TCard.ini
tclock-win11.ini

# Local recovery copies, diagnostics and test captures.
*.old
*.old[0-9]*
*.org
*.bak
*.tmp
*.dmp
*.log
*.bmp

# Local environment files and private signing material.
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
